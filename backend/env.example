# ---------------------------------------------------------------
# LLM (any OpenAI-compatible chat completions endpoint with tools)
# Pick ONE of the free options below and paste your key.
# ---------------------------------------------------------------

# Option A: Groq (free key at https://console.groq.com/keys)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Alternatives on Groq: qwen/qwen3.8-27b, openai/gpt-oss-20b (faster, higher rate limits)

# Option B: Google Gemini (free key at https://aistudio.google.com/apikey)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=
# LLM_MODEL=gemini-2.5-flash

LLM_TEMPERATURE=0.2
# gpt-oss models think before answering. low = fast voice turns.
# Options: low | medium | high | none (do not send the parameter)
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_MS=45000

# ---------------------------------------------------------------
# Embeddings
# "local" runs all-MiniLM-L6-v2 on your machine via transformers.js:
# no key, no cost, ~25 MB model downloaded once on first start.
# "api" uses an OpenAI-compatible /embeddings endpoint instead.
# ---------------------------------------------------------------
EMBEDDINGS_PROVIDER=local
EMBEDDINGS_MODEL=Xenova/all-MiniLM-L6-v2
# EMBEDDINGS_PROVIDER=api
# EMBEDDINGS_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# EMBEDDINGS_API_KEY=
# EMBEDDINGS_API_MODEL=gemini-embedding-001

# ---------------------------------------------------------------
# Retrieval tuning (cosine similarity, 0..1)
# Results below SEARCH_MIN_SCORE are dropped. If the best result is
# below SEARCH_SUFFICIENT_SCORE the agent treats retrieval as weak
# and either searches again with new wording or admits it doesn't know.
# Run `npm run eval:retrieval` to see real scores before tuning.
# ---------------------------------------------------------------
SEARCH_TOP_K=4
SEARCH_MIN_SCORE=0.25
SEARCH_SUFFICIENT_SCORE=0.40

# ---------------------------------------------------------------
# Server
# ---------------------------------------------------------------
PORT=4000
# Max agent turns per IP per minute
RATE_LIMIT_PER_MINUTE=20
CORS_ORIGIN=http://localhost:3000
KB_DIR=../knowledge-base
AGENT_MAX_STEPS=6
# Earlier turns kept as plain text (facts like email/invoice live in memory separately)
AGENT_HISTORY_MESSAGES=12
# Hard time budget per turn; keep below the frontend proxy timeout (120 s)
AGENT_TURN_TIMEOUT_MS=75000
# Second-pass grounding check of knowledge-base answers (one extra LLM call)
AGENT_VERIFY=true
